# Copy to .env. The API fails closed if Supabase settings are missing.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
SUPABASE_MEDIA_BUCKET=socialorbit-media
# 32-byte key encoded as 64 hexadecimal characters. Generate with openssl rand -hex 32.
ENCRYPTION_KEY_HEX=
REDIS_URL=redis://127.0.0.1:6379
# Social OAuth: use provider-specific approved scopes. All credentials stay server-side.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/youtube.upload
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid,profile,w_member_social
# Publishing remains gated by the actual permissions of each connected account.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
# Payment providers: live checkout is disabled until credentials are configured.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Worker safety: must explicitly enable before publishing external posts.
ENABLE_PUBLISHING=false
ENABLE_SOCIAL_SYNC=false
ENABLE_MEDIA_CLEANUP=true
