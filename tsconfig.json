{
  "compilerOptions": {
    "target":"ES2022", "module":"ESNext", "moduleResolution":"Bundler", "allowImportingTsExtensions":true,
    "noEmit":true, "strict":true, "skipLibCheck":true, "allowSyntheticDefaultImports":true,
    "esModuleInterop":true, "resolveJsonModule":true, "types":["node"], "lib":["ES2022","DOM"],
    "forceConsistentCasingInFileNames":true
  },
  "include":["apps/**/*.ts", "packages/**/*.ts"]
}
